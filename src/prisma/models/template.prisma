model Template {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String         @unique @db.VarChar(100)
  name            String         @db.VarChar(100)
  description     String?        @db.Text
  categoryId      Int            @map("category_id") @db.SmallInt
  requiresSource  Boolean        @default(false) @map("requires_source")
  status          TemplateStatus @default(draft)
  version         Int            @default(1)
  defaultPaletteId String?       @map("default_palette_id") @db.Uuid
  createdBy       String?        @map("created_by") @db.Uuid
  publishedAt     DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category       TemplateCategory  @relation(fields: [categoryId], references: [id])
  defaultPalette Palette?          @relation(fields: [defaultPaletteId], references: [id])
  creator        User?             @relation("TemplateCreator", fields: [createdBy], references: [id])
  variants       TemplateVariant[]
  slots          Slot[]
  videos         Video[]
  contentReports ContentReport[]

  @@index([status, categoryId, publishedAt], map: "idx_templates_gallery")
  @@map("templates")
}

